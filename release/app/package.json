{
  "name": "lappen-recorder",
  "version": "8.0.0-rc.5",
  "description": "Lappen Recorder - an unofficial World of Warcraft gameplay recorder",
  "main": "./dist/main/main.js",
  "author": {
    "name": "Lappen Recorder contributors"
  },
  "scripts": {
    "electron-rebuild": "node -r ts-node/register ../../.erb/scripts/electron-rebuild.js",
